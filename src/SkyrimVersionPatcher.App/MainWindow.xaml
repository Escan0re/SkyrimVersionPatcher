<Window x:Class="SkyrimVersionPatcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkyrimVersionPatcher.App"
        Title="{DynamicResource Ui.Text001}"
        Icon="Assets/SkyrimVersionPatcher.ico"
        Width="940" Height="720" MinWidth="820" MinHeight="650"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Background="{DynamicResource WizardBackground}" Foreground="{DynamicResource WizardText}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=InstallButton}"
        local:WizardMotion.IsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/WizardTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="WizardLanguageFlag" TargetType="ToggleButton">
                <Setter Property="Width" Value="54"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource WizardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Surface" Background="Transparent" BorderBrush="{StaticResource WizardLine}" BorderThickness="1" CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource WizardHover}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource WizardSurface}"/>
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource WizardAccent}"/>
                                    <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource WizardAccent}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="{StaticResource WizardRail}" BorderBrush="{StaticResource WizardLine}" BorderThickness="0,0,1,0" Padding="18,28,18,24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Grid Margin="4,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="Assets/SkyrimVersionPatcher.png" Width="40" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Skyrim" FontFamily="Georgia" FontSize="23"/>
                            <TextBlock Text="Version Patcher" Foreground="{StaticResource WizardMuted}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource WizardLine}" Margin="4,24,4,20"/>
                    <TextBlock Text="{DynamicResource Ui.Text002}" FontSize="12" Foreground="{StaticResource WizardMuted}" Margin="12,0,0,14"/>
                    <ContentControl x:Name="StepWelcomeItem" Uid="1" Content="{DynamicResource Ui.Text003}" Tag="Current" Style="{StaticResource WizardStep}"/>
                    <ContentControl x:Name="StepLocationItem" Uid="2" Content="{DynamicResource Ui.Text004}" Tag="Upcoming" Style="{StaticResource WizardStep}"/>
                    <ContentControl x:Name="StepOptionsItem" Uid="3" Content="{DynamicResource Ui.Text005}" Tag="Upcoming" Style="{StaticResource WizardStep}"/>
                    <ContentControl x:Name="StepReviewItem" Uid="4" Content="{DynamicResource Ui.Text006}" Tag="Upcoming" Style="{StaticResource WizardStep}"/>
                    <ContentControl x:Name="StepOperationItem" Uid="5" Content="{DynamicResource Ui.Text007}" Tag="Upcoming" Style="{StaticResource WizardStep}"/>
                    <ContentControl x:Name="StepResultItem" Uid="6" Content="{DynamicResource Ui.Text008}" Tag="Upcoming" Style="{StaticResource WizardStep}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="12,12,0,0">
                    <TextBlock x:Name="StepText" Text="{DynamicResource Ui.Text009}" Foreground="{StaticResource WizardAccent}" FontSize="12" AutomationProperties.Name="{DynamicResource Ui.Text010}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ToggleButton x:Name="RussianLanguageButton" Tag="ru" Click="InterfaceLanguage_Click" Style="{StaticResource WizardLanguageFlag}" ToolTip="{DynamicResource Ui.Text011}" AutomationProperties.Name="{DynamicResource Ui.Text012}" TabIndex="90">
                            <Grid Width="30" Height="20" IsHitTestVisible="False">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Rectangle Fill="#FFFFFF"/>
                                <Rectangle Grid.Row="1" Fill="#0039A6"/>
                                <Rectangle Grid.Row="2" Fill="#D52B1E"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="EnglishLanguageButton" Tag="en" Click="InterfaceLanguage_Click" Style="{StaticResource WizardLanguageFlag}" Margin="8,0,0,0" ToolTip="English" AutomationProperties.Name="English — interface language" TabIndex="91">
                            <Canvas Width="30" Height="20" ClipToBounds="True" IsHitTestVisible="False" Background="#012169">
                                <Path Data="M 0,0 L 30,20 M 30,0 L 0,20" Stroke="White" StrokeThickness="5"/>
                                <Path Data="M 0,0 L 15,10 M 30,20 L 15,10" Stroke="#C8102E" StrokeThickness="2"/>
                                <Path Data="M 30,0 L 15,10 M 0,20 L 15,10" Stroke="#C8102E" StrokeThickness="2"/>
                                <Rectangle Width="30" Height="7" Canvas.Top="6.5" Fill="White"/>
                                <Rectangle Width="7" Height="20" Canvas.Left="11.5" Fill="White"/>
                                <Rectangle Width="30" Height="4" Canvas.Top="8" Fill="#C8102E"/>
                                <Rectangle Width="4" Height="20" Canvas.Left="13" Fill="#C8102E"/>
                            </Canvas>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32,28,28,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="PageHeader" Margin="0,0,0,16">
                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                <TextBlock x:Name="PageTitleText" Text="{DynamicResource Ui.Text013}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageDescriptionText" Text="{DynamicResource Ui.Text014}" Foreground="{StaticResource WizardMuted}" Margin="0,8,0,0" FontSize="13"/>
            </StackPanel>
            <ScrollViewer x:Name="PageScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0" Focusable="False">
                <Grid x:Name="PageContent">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid x:Name="ConfigurationPanel">
                        <StackPanel x:Name="WelcomePage">
                            <TextBlock Text="{DynamicResource Ui.WelcomeIntro}" FontSize="13" LineHeight="20"/>
                            <TextBlock Text="{DynamicResource Ui.WelcomeFeatures}" FontSize="13" LineHeight="22" Margin="0,12,0,0"/>
                            <TextBlock Text="{DynamicResource Ui.Text017}" Style="{StaticResource WizardLabel}" Margin="0,22,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource WizardSurface}" VerticalAlignment="Top">
                                    <Path Data="M 3,9 A 4,4 0 1 1 11,9 A 4,4 0 1 1 3,9 M 11,9 L 18,9 L 18,12 M 15,9 L 15,11" Stroke="{StaticResource WizardAccent}" StrokeThickness="1.5" Width="21" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Ui.Text018}" FontSize="13" LineHeight="20" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource WizardSurface}" VerticalAlignment="Top">
                                    <Path Data="M 1,1 L 19,1 L 19,16 L 1,16 Z M 1,5 L 19,5 M 8,8 L 13,13 M 13,8 L 8,13" Stroke="{StaticResource WizardAccent}" StrokeThickness="1.5" Width="19" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Ui.Text019}" FontSize="13" LineHeight="20" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock FontSize="13" Margin="0,22,0,0"><Run Text="{DynamicResource Ui.WelcomeAuthorLabel}"/><Run Text="Escan0re" FontWeight="Bold"/></TextBlock>
                            <TextBlock Text="{DynamicResource Ui.Text020}" Style="{StaticResource WizardHelp}" Margin="0,12,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="LocationPage" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Ui.Text021}" Style="{StaticResource WizardLabel}"/>
                            <TextBox x:Name="GameDirectoryBox" IsReadOnly="True" FontSize="12" TextWrapping="NoWrap" TabIndex="10" AutomationProperties.Name="{DynamicResource Ui.Text021}" AutomationProperties.HelpText="{DynamicResource Ui.Text022}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{DynamicResource Ui.Text023}" Click="BrowseGame_Click" TabIndex="11" AutomationProperties.Name="{DynamicResource Ui.Text024}"/>
                                <Button Content="{DynamicResource Ui.Text025}" Click="FindSteam_Click" Margin="8,0,0,0" TabIndex="12" AutomationProperties.Name="{DynamicResource Ui.Text026}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Ui.Text027}" Style="{StaticResource WizardHelp}"/>
                            <Border Background="{StaticResource WizardSurface}" BorderBrush="{StaticResource WizardLine}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,22,0,0">
                                <TextBlock x:Name="CurrentVersionText" FontSize="14" AutomationProperties.Name="{DynamicResource Ui.Text030}"><Run Text="{DynamicResource Ui.SkyrimVersionLabel}"/><Run x:Name="CurrentVersionValue" Text="{DynamicResource Ui.UnknownVersion}" FontWeight="Bold"/></TextBlock>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
                            <Border Style="{StaticResource WizardCard}" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Ui.Text031}" Style="{StaticResource WizardLabel}"/>
                                    <ComboBox x:Name="VersionBox" DisplayMemberPath="DisplayName" SelectionChanged="VersionBox_SelectionChanged" TabIndex="20" AutomationProperties.Name="{DynamicResource Ui.Text032}"/>
                                    <TextBlock Text="{DynamicResource Ui.Text033}" Style="{StaticResource WizardLabel}" Margin="0,14,0,8"/>
                                    <ComboBox x:Name="LocalizationBox" DisplayMemberPath="NativeName" SelectionChanged="LocalizationBox_SelectionChanged" TabIndex="21" AutomationProperties.Name="{DynamicResource Ui.Text033}" AutomationProperties.HelpText="{DynamicResource Ui.Text034}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <CheckBox x:Name="RenameCatalogCheckBox" IsChecked="True" VerticalAlignment="Center" Checked="Configuration_Changed" Unchecked="Configuration_Changed" TabIndex="22" AutomationProperties.Name="{DynamicResource Ui.RenameCatalogRecommended}" AutomationProperties.HelpText="{DynamicResource Ui.Text036}">
                                            <CheckBox.Content>
                                                <TextBlock><Run Text="{DynamicResource Ui.Text035}"/><Run Text=" "/><Bold><Run Text="{DynamicResource Ui.Recommended}"/></Bold></TextBlock>
                                            </CheckBox.Content>
                                        </CheckBox>
                                        <Button x:Name="CatalogHelpButton" Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0" Margin="4,0,0,0" Style="{StaticResource WizardQuietButton}" TabIndex="23" AutomationProperties.Name="{DynamicResource Ui.CatalogHelp}" Click="CatalogHelp_Click" GotKeyboardFocus="CatalogHelp_GotKeyboardFocus" LostKeyboardFocus="CatalogHelp_LostKeyboardFocus" PreviewKeyDown="CatalogHelp_KeyDown" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                                            <Border Width="18" Height="18" CornerRadius="9" BorderBrush="{StaticResource WizardMuted}" BorderThickness="1.3">
                                                <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WizardMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button.ToolTip>
                                                <ToolTip x:Name="CatalogTooltip" Placement="Bottom" MaxWidth="410" Background="{StaticResource WizardSurface}" Foreground="{StaticResource WizardText}" BorderBrush="{StaticResource WizardInputLine}" Padding="12,10" Opened="CatalogTooltip_Opened">
                                                    <TextBlock x:Name="CatalogHelpText" Foreground="{StaticResource WizardText}" FontSize="14" TextWrapping="Wrap" MaxWidth="370" LineHeight="21"/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <CheckBox x:Name="StopUpdatesCheckBox" IsChecked="True" Margin="0,10,0,0" Checked="Configuration_Changed" Unchecked="Configuration_Changed" TabIndex="24" AutomationProperties.Name="{DynamicResource Ui.StopUpdatesRecommended}" AutomationProperties.HelpText="{DynamicResource Ui.StopUpdatesHelp}">
                                        <CheckBox.Content>
                                            <TextBlock><Run Text="{DynamicResource Ui.StopUpdates}"/><Run Text=" "/><Bold><Run Text="{DynamicResource Ui.Recommended}"/></Bold></TextBlock>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource WizardCard}" Padding="16,12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Ui.Text038}" Style="{StaticResource WizardLabel}"/>
                                    <ComboBox x:Name="ModeBox" DisplayMemberPath="Label" SelectionChanged="ModeBox_SelectionChanged" TabIndex="25" AutomationProperties.Name="{DynamicResource Ui.Text038}"/>
                                    <TextBlock x:Name="ModeDescriptionText" Style="{StaticResource WizardHelp}" Margin="0,6,0,0"/>
                                    <StackPanel x:Name="LocalDepotPanel" Visibility="Collapsed" local:WizardMotion.RevealOnVisible="True">
                                        <TextBlock Text="{DynamicResource Ui.Text039}" Style="{StaticResource WizardLabel}" Margin="0,10,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="LocalDirectoryBox" IsReadOnly="False" FontSize="12" TextWrapping="NoWrap" TextChanged="LocalDirectory_Changed" TabIndex="26" AutomationProperties.Name="{DynamicResource Ui.Text039}" AutomationProperties.HelpText="{DynamicResource Ui.Text040}"/>
                                            <Button Grid.Column="1" Content="{DynamicResource Ui.Text041}" Click="BrowseLocal_Click" Margin="8,0,0,0" TabIndex="27" AutomationProperties.Name="{DynamicResource Ui.Text042}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="ReviewPage" Visibility="Collapsed">
                            <Border Background="{StaticResource WizardSurface}" BorderBrush="{StaticResource WizardLine}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource Ui.Text004}" Foreground="{StaticResource WizardMuted}" FontSize="12" Margin="0,0,14,14"/>
                                    <TextBlock x:Name="ReviewDirectoryText" Grid.Column="1" FontSize="12" Margin="0,0,0,14" AutomationProperties.Name="{DynamicResource Ui.Text043}"/>
                                    <TextBlock Grid.Row="1" Text="{DynamicResource Ui.Text044}" Foreground="{StaticResource WizardMuted}" FontSize="12" Margin="0,0,14,14"/>
                                    <TextBlock x:Name="ReviewVersionText" Grid.Row="1" Grid.Column="1" FontSize="20" Foreground="{StaticResource WizardAccent}" FontWeight="SemiBold" Margin="0,0,0,14" AutomationProperties.Name="{DynamicResource Ui.Text045}"/>
                                    <TextBlock Grid.Row="2" Text="{DynamicResource Ui.Text046}" Foreground="{StaticResource WizardMuted}" FontSize="12" Margin="0,0,14,14"/>
                                    <TextBlock x:Name="ReviewLanguageText" Grid.Row="2" Grid.Column="1" FontSize="12" Margin="0,0,0,14" AutomationProperties.Name="{DynamicResource Ui.Text047}"/>
                                    <TextBlock Grid.Row="3" Text="{DynamicResource Ui.Text048}" Foreground="{StaticResource WizardMuted}" FontSize="12" Margin="0,0,14,14"/>
                                    <TextBlock x:Name="ReviewModeText" Grid.Row="3" Grid.Column="1" FontSize="12" Margin="0,0,0,14" AutomationProperties.Name="{DynamicResource Ui.Text049}"/>
                                    <TextBlock x:Name="ReviewLocalDirectoryLabel" Grid.Row="4" Text="{DynamicResource Ui.Text039}" Visibility="Collapsed" Foreground="{StaticResource WizardMuted}" FontSize="12" Margin="0,0,14,14"/>
                                    <TextBlock x:Name="ReviewLocalDirectoryText" Grid.Row="4" Grid.Column="1" Visibility="Collapsed" FontSize="12" Margin="0,0,0,14" AutomationProperties.Name="{DynamicResource Ui.Text050}"/>
                                    <TextBlock Grid.Row="5" Text="{DynamicResource Ui.Text051}" Foreground="{StaticResource WizardMuted}" FontSize="12" Margin="0,0,14,14"/>
                                    <TextBlock x:Name="ReviewCatalogText" Grid.Row="5" Grid.Column="1" FontSize="12" Margin="0,0,0,14" AutomationProperties.Name="{DynamicResource Ui.Text052}"/>
                                    <TextBlock Grid.Row="6" Text="{DynamicResource Ui.Updates}" Foreground="{StaticResource WizardMuted}" FontSize="12" Margin="0,0,14,0"/>
                                    <TextBlock x:Name="ReviewUpdatesText" Grid.Row="6" Grid.Column="1" FontSize="12" AutomationProperties.Name="{DynamicResource Ui.StopUpdates}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{DynamicResource Ui.Text053}" Style="{StaticResource WizardHelp}" Margin="0,18,0,0" FontSize="13"/>
                            <TextBlock Text="{DynamicResource Ui.Text054}" Style="{StaticResource WizardHelp}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="OperationPage" Visibility="Collapsed">
                        <Border Style="{StaticResource WizardCard}">
                            <StackPanel>
                                <Border x:Name="ResultIconBorder" Width="48" Height="48" CornerRadius="24" Background="{StaticResource WizardHover}" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                    <TextBlock x:Name="ResultSymbolText" Text="✓" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource WizardSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="StatusText" Text="{DynamicResource Ui.Text055}" FontWeight="SemiBold" FontSize="16" LineHeight="23" AutomationProperties.Name="{DynamicResource Ui.Text056}"/>
                                <TextBlock x:Name="DetailText" Text="{DynamicResource Ui.Text057}" Style="{StaticResource WizardHelp}" AutomationProperties.Name="{DynamicResource Ui.Text058}"/>
                                <ProgressBar x:Name="OperationProgress" Height="8" Margin="0,20,0,0" Minimum="0" Maximum="100" AutomationProperties.Name="{DynamicResource Ui.Text059}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ProgressStagesPanel" Background="{StaticResource WizardSurface}" BorderBrush="{StaticResource WizardLine}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock x:Name="PreparationStepText" Text="{DynamicResource Ui.Text060}" FontSize="13"/>
                                <TextBlock x:Name="VerificationStepText" Text="{DynamicResource Ui.Text061}" FontSize="13" Margin="0,10,0,0"/>
                                <TextBlock x:Name="InstallationStepText" Text="{DynamicResource Ui.Text063}" FontSize="13" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="ResultActionsPanel" Visibility="Collapsed" Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource Ui.Text004}" Style="{StaticResource WizardLabel}"/>
                            <TextBlock x:Name="ResultDirectoryText" FontSize="12" Foreground="{StaticResource WizardMuted}" AutomationProperties.Name="{DynamicResource Ui.Text064}"/>
                            <Button Content="{DynamicResource Ui.Text065}" Click="OpenGameFolder_Click" HorizontalAlignment="Left" Margin="0,8,0,0" TabIndex="50" AutomationProperties.Name="{DynamicResource Ui.Text066}"/>
                        </StackPanel>
                        <Expander Header="{DynamicResource Ui.Text071}" Margin="0,20,0,0" TabIndex="52" AutomationProperties.Name="{DynamicResource Ui.Text072}">
                            <TextBlock x:Name="StatisticsText" Text="{DynamicResource Ui.Text073}" Style="{StaticResource WizardHelp}" Margin="0,12,0,0" AutomationProperties.Name="{DynamicResource Ui.Text074}"/>
                        </Expander>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="NavigationHintText" Grid.Row="2" Text="" Style="{StaticResource WizardValidation}" AutomationProperties.Name="{DynamicResource Ui.Text075}"/>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource WizardBackground}" BorderBrush="{StaticResource WizardLine}" BorderThickness="0,1,0,0" Padding="32,18,28,18">
            <Grid>
                <Button x:Name="CancelButton" Content="{DynamicResource Ui.Text076}" Click="Cancel_Click" IsCancel="True" HorizontalAlignment="Left" Style="{StaticResource WizardQuietButton}" MinWidth="84" TabIndex="80" AutomationProperties.Name="{DynamicResource Ui.Text077}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="{DynamicResource Ui.Text078}" Click="Back_Click" IsEnabled="False" MinWidth="96" TabIndex="81" AutomationProperties.Name="{DynamicResource Ui.Text079}"/>
                    <Button x:Name="InstallButton" Content="{DynamicResource Ui.Text080}" Click="Install_Click" IsDefault="True" MinWidth="140" Margin="10,0,0,0" Style="{StaticResource WizardPrimaryButton}" TabIndex="82" AutomationProperties.Name="{DynamicResource Ui.Text081}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
