<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SkyrimVersionPatcher.App">
    <!-- Frost and slate: the application's dragon emblem supplies the accent. -->
    <SolidColorBrush x:Key="WizardBackground" Color="#151D27"/>
    <SolidColorBrush x:Key="WizardRail" Color="#101720"/>
    <SolidColorBrush x:Key="WizardSurface" Color="#1E2A37"/>
    <SolidColorBrush x:Key="WizardHover" Color="#293A4B"/>
    <SolidColorBrush x:Key="WizardText" Color="#EDF3F8"/>
    <SolidColorBrush x:Key="WizardMuted" Color="#A8B8C8"/>
    <SolidColorBrush x:Key="WizardLine" Color="#35495D"/>
    <SolidColorBrush x:Key="WizardInputLine" Color="#647D93"/>
    <SolidColorBrush x:Key="WizardAccent" Color="#9AD5FA"/>
    <SolidColorBrush x:Key="WizardAccentHover" Color="#BFE5FC"/>
    <SolidColorBrush x:Key="WizardOnAccent" Color="#122233"/>
    <SolidColorBrush x:Key="WizardSuccess" Color="#9DDCC0"/>
    <SolidColorBrush x:Key="WizardError" Color="#FFB4A9"/>

    <Style x:Key="WizardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border BorderBrush="{StaticResource WizardAccent}" BorderThickness="2"
                            CornerRadius="9" Margin="-3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource WizardText}"/>
    </Style>
    <Style x:Key="WizardLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="WizardHelp" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource WizardMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style x:Key="WizardCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WizardSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WizardLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="WizardValidation" TargetType="TextBlock" BasedOn="{StaticResource WizardHelp}">
        <Setter Property="Foreground" Value="{StaticResource WizardError}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WizardSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource WizardText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WizardInputLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WizardFocus}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5" local:WizardMotion.ScaleTarget="1">
                        <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" local:WizardMotion.OpacityTarget="1"/>
                        <Border x:Name="HoverSurface" Background="{StaticResource WizardText}" CornerRadius="8"
                                local:WizardMotion.OpacityTarget="0" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        <Border x:Name="FocusRing" BorderBrush="{StaticResource WizardAccent}" BorderThickness="2"
                                CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource WizardAccent}"/>
                            <Setter TargetName="HoverSurface" Property="local:WizardMotion.OpacityTarget" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="local:WizardMotion.OpacityTarget" Value="0.82"/>
                            <Setter TargetName="ButtonRoot" Property="local:WizardMotion.ScaleTarget" Value="0.975"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="HoverSurface" Property="local:WizardMotion.OpacityTarget" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource WizardAccent}"/>
        <Setter Property="Foreground" Value="{StaticResource WizardOnAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WizardAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="WizardQuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource WizardMuted}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource WizardRail}"/>
        <Setter Property="Foreground" Value="{StaticResource WizardText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WizardInputLine}"/>
        <Setter Property="CaretBrush" Value="{StaticResource WizardAccent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource WizardAccent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WizardFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource WizardAccent}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource WizardAccent}"/></Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource WizardMuted}"/>
                            <Setter Property="Background" Value="{StaticResource WizardSurface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource WizardText}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource WizardHover}"/></Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource WizardHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource WizardAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource WizardText}"/>
        <Setter Property="Background" Value="{StaticResource WizardRail}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WizardInputLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="MaxDropDownHeight" Value="280"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WizardFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleSurface" CornerRadius="8"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1">
                                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource WizardMuted}" StrokeThickness="1.5"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{StaticResource WizardAccent}"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{StaticResource WizardAccent}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,10,38,10" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Border x:Name="FocusRing" CornerRadius="8" BorderBrush="{StaticResource WizardAccent}" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource WizardSurface}" BorderBrush="{StaticResource WizardInputLine}"
                                    BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,5,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource WizardText}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,4,0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WizardFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="CheckSurface" Width="22" Height="22" CornerRadius="5" BorderThickness="1"
                                Background="{StaticResource WizardRail}" BorderBrush="{StaticResource WizardInputLine}" VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5" local:WizardMotion.ScaleTarget="1">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <Grid>
                                <Border x:Name="CheckedFill" Background="{StaticResource WizardAccent}" CornerRadius="4"
                                        local:WizardMotion.OpacityTarget="0"/>
                                <Path x:Name="CheckMark" Data="M 1,5 L 5,9 L 12,1" Stroke="{StaticResource WizardOnAccent}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5" local:WizardMotion.OpacityTarget="0" local:WizardMotion.ScaleTarget="0.8">
                                    <Path.RenderTransform><ScaleTransform/></Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckedFill" Property="local:WizardMotion.OpacityTarget" Value="1"/>
                            <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource WizardAccent}"/>
                            <Setter TargetName="CheckMark" Property="local:WizardMotion.OpacityTarget" Value="1"/>
                            <Setter TargetName="CheckMark" Property="local:WizardMotion.ScaleTarget" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource WizardAccent}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="CheckSurface" Property="local:WizardMotion.ScaleTarget" Value="0.94"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WizardStep" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{StaticResource WizardMuted}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="StepSurface" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"/>
                        <Border x:Name="StepHighlight" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource WizardLine}"
                                Background="{StaticResource WizardSurface}" local:WizardMotion.OpacityTarget="0"/>
                        <Grid Margin="11,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="StepBadge" Background="{StaticResource WizardSurface}" CornerRadius="14" Width="28" Height="28">
                                <TextBlock x:Name="StepNumber" Text="{TemplateBinding Uid}" FontSize="12"
                                           Foreground="{TemplateBinding Foreground}" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Current">
                            <Setter TargetName="StepHighlight" Property="local:WizardMotion.OpacityTarget" Value="1"/>
                            <Setter TargetName="StepBadge" Property="Background" Value="{StaticResource WizardAccent}"/>
                            <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource WizardOnAccent}"/>
                            <Setter Property="Foreground" Value="{StaticResource WizardText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Complete">
                            <Setter TargetName="StepNumber" Property="Text" Value="✓"/>
                            <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource WizardSuccess}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Failed">
                            <Setter TargetName="StepHighlight" Property="local:WizardMotion.OpacityTarget" Value="1"/>
                            <Setter TargetName="StepNumber" Property="Text" Value="!"/>
                            <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource WizardError}"/>
                            <Setter Property="Foreground" Value="{StaticResource WizardError}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource WizardText}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" TabIndex="{TemplateBinding TabIndex}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      FocusVisualStyle="{StaticResource WizardFocus}" Cursor="Hand" MinHeight="36">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="6" Padding="2,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource WizardMuted}"
                                                  StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                                  local:WizardMotion.AngleTarget="0">
                                                <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="local:WizardMotion.AngleTarget" Value="90"/></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource WizardHover}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" Margin="22,4,0,0" local:WizardMotion.RevealOnVisible="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource WizardAccent}"/>
        <Setter Property="Background" Value="{StaticResource WizardLine}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                        <Border x:Name="BusyTrack" Background="{TemplateBinding Foreground}" CornerRadius="4" Opacity="0.16" Visibility="Collapsed"/>
                        <Border x:Name="BusyIndicator" Background="{TemplateBinding Foreground}" CornerRadius="4" Opacity="0.8" Visibility="Collapsed">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform><TranslateTransform/></LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0.15"/>
                                    <GradientStop Color="White" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="0.85"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BusyIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BusyTrack" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsIndeterminate" Value="True"/>
                                <Condition Property="local:WizardMotion.IsEnabled" Value="True"/>
                                <Condition Property="IsVisible" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="BusySweep"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="BusyIndicator"
                                                     Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                     From="-0.85" To="0.85" Duration="0:0:1.6" RepeatBehavior="Forever"/>
                                </Storyboard></BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="BusySweep"/></MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Background="{StaticResource WizardInputLine}">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="3,0"/></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource WizardSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource WizardText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WizardInputLine}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MaxWidth" Value="480"/>
    </Style>
</ResourceDictionary>
