<Window x:Class="SkyrimVersionPatcher.App.InstallationWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="Assets/SkyrimVersionPatcher.ico"
        Background="{DynamicResource WizardBackground}" Foreground="{DynamicResource WizardText}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/WizardTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="24,24,24,10" KeyboardNavigation.TabNavigation="Cycle">
        <Grid x:Name="StopUpdatesPanel" ClipToBounds="True">
            <Border x:Name="StopUpdatesCard" Style="{StaticResource WizardCard}" Margin="0,0,0,14" VerticalAlignment="Top">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <StackPanel>
                    <TextBlock x:Name="StopUpdatesWarningText" TextWrapping="Wrap" LineHeight="23"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="StopUpdatesYesButton" MinWidth="96" Style="{StaticResource WizardPrimaryButton}" Click="StopUpdatesYes_Click"/>
                        <Button x:Name="StopUpdatesNoButton" MinWidth="96" Margin="10,0,0,0" Click="StopUpdatesNo_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="RenameCatalogPanel" ClipToBounds="True">
            <Border x:Name="RenameCatalogCard" Style="{StaticResource WizardCard}" Margin="0,0,0,14" VerticalAlignment="Top">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <StackPanel>
                    <TextBlock x:Name="RenameCatalogWarningText" TextWrapping="Wrap" LineHeight="23"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="RenameCatalogYesButton" MinWidth="96" Style="{StaticResource WizardPrimaryButton}" Click="RenameCatalogYes_Click"/>
                        <Button x:Name="RenameCatalogNoButton" MinWidth="96" Margin="10,0,0,0" Click="RenameCatalogNo_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Window>
