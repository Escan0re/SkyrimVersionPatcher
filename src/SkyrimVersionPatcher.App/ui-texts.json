  "Ui.WelcomeIntro": {
    "ru": "Этот мастер поможет установить Skyrim Special Edition 1.5.97 или Anniversary Edition 1.6.1170 для вашей сборки модов.",
    "en": "This wizard helps you install Skyrim Special Edition 1.5.97 or Anniversary Edition 1.6.1170 for your mod setup."
  },
  "Ui.WelcomeFeatures": {
    "ru": "• Загрузка файлов через Steam или установка из готовых depot.\n• Выбор одной из девяти локализаций игры.\n• Проверка файлов перед установкой.",
    "en": "• Download files through Steam or install from existing depot files.\n• Choose from nine game languages.\n• Verify files before installation."
  },
  "Ui.WelcomeAuthorLabel": {
    "ru": "Автор проекта: ",
    "en": "Created by: "
  },
  "Ui.Text017": {
    "ru": "Перед началом",
    "en": "Before you start"
  },
  "Ui.Text018": {
    "ru": "1. Для загрузки файлов откройте Steam и войдите в аккаунт с доступом к Skyrim SE.",
    "en": "1. To download files, open Steam and sign in to an account that owns Skyrim SE."
  },
  "Ui.Text019": {
    "ru": "2. Закройте Skyrim, лаунчер и SKSE.",
    "en": "2. Close Skyrim, its launcher and SKSE."
  },
  "Ui.Text020": {
    "ru": "Нажмите «Далее», чтобы выбрать папку игры и параметры установки.",
    "en": "Click “Next” to choose the game folder and installation options."
  },
  "Ui.Text021": {
    "ru": "Папка Skyrim",
    "en": "Skyrim folder"
  },
  "Ui.Text022": {
    "ru": "Папка уже установленной игры или её отдельной копии",
    "en": "Folder containing the installed game or a separate copy"
  },
  "Ui.Text023": {
    "ru": "Выбрать папку…",
    "en": "Choose folder…"
  },
  "Ui.Text024": {
    "ru": "Выбрать папку Skyrim",
    "en": "Choose Skyrim folder"
  },
  "Ui.Text025": {
    "ru": "Найти в Steam",
    "en": "Find in Steam"
  },
  "Ui.Text026": {
    "ru": "Найти установленную Skyrim в Steam",
    "en": "Find the installed Skyrim in Steam"
  },
  "Ui.Text027": {
    "ru": "В папке должны находиться SkyrimSE.exe и Data\\Skyrim.esm.",
    "en": "The folder must contain SkyrimSE.exe and Data\\Skyrim.esm."
  },
